<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="normal-ads-043-add-success-failed-counts" author="copilot">
        <addColumn tableName="ADS_NORMAL_INFO">
            <column name="SUCCESS_COUNT" type="BIGINT"/>
            <column name="FAILED_COUNT" type="BIGINT"/>
            <column name="LAST_SUCCESS_DATE" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
