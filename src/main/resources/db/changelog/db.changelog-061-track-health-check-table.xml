<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="061-create-track-health-check" author="copilot">
        <createTable tableName="TRACK_HEALTH_CHECK">
            <column name="ID" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="SLUG" type="varchar(64)"/>
            <column name="ADS_OWNER" type="varchar(32)"/>
            <column name="CAMPAIGN_NAME" type="varchar(128)"/>
            <!-- 首跳状态码 / status code of the first hop -->
            <column name="FIRST_STATUS" type="INT"/>
            <column name="HOP_COUNT" type="INT"/>
            <!-- 第一跳的 Location, 即生成的联盟链接 / Location of first hop, the generated affiliate url -->
            <column name="TARGET_URL" type="varchar(1024)"/>
            <column name="FINAL_URL" type="varchar(1024)"/>
            <column name="FINAL_HOST" type="varchar(256)"/>
            <!-- 爬虫 UA 的最终地址, 用于对比 / final url of the crawler UA request, for comparison -->
            <column name="BOT_FINAL_URL" type="varchar(1024)"/>
            <column name="LANDING_OK" type="varchar(8)"/>
            <column name="AUTO_REDIRECT" type="varchar(8)"/>
            <column name="CLOAK_SUSPECTED" type="varchar(8)"/>
            <!-- 最终地址是否仍带 gclid, 仅记录 / whether gclid still present, record only -->
            <column name="GCLID_PASSED" type="varchar(8)"/>
            <column name="PASSED" type="varchar(8)"/>
            <column name="MESSAGE" type="varchar(512)"/>
            <column name="RAW_CHAIN" type="varchar(2048)"/>
            <column name="CHECK_TIME" type="datetime"/>
            <column name="CREATE_DATE" type="datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="TRACK_HEALTH_CHECK" indexName="IDX_TRACK_HEALTH_SLUG">
            <column name="SLUG"/>
        </createIndex>

        <createIndex tableName="TRACK_HEALTH_CHECK" indexName="IDX_TRACK_HEALTH_OWNER">
            <column name="ADS_OWNER"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
