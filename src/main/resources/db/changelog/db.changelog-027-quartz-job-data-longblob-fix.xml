<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="quartz-016-fix-job-data-column-types" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="QRTZ_JOB_DETAILS"/>
            <tableExists tableName="QRTZ_TRIGGERS"/>
        </preConditions>

        <modifyDataType tableName="QRTZ_JOB_DETAILS" columnName="JOB_DATA" newDataType="LONGBLOB"/>
        <modifyDataType tableName="QRTZ_TRIGGERS" columnName="JOB_DATA" newDataType="LONGBLOB"/>
    </changeSet>

</databaseChangeLog>
