<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- Matrix 中间链接行记录归属用的关键 ID / store the match id used to classify matrix affiliate rows -->
    <changeSet id="matrix-affiliate-001-add-match-id" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="ADS_MATRIX_AFFILIATE_INFO" columnName="MATCH_ID"/>
            </not>
        </preConditions>
        <addColumn tableName="ADS_MATRIX_AFFILIATE_INFO">
            <column name="MATCH_ID" type="VARCHAR(128)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
