<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- 中间链接记录实际归类的关键 ID / store the match id used for middle link classification -->
    <changeSet id="middle-link-003-add-match-id" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="MIDDLE_LINK" columnName="MATCH_ID"/>
            </not>
        </preConditions>
        <addColumn tableName="MIDDLE_LINK">
            <column name="MATCH_ID" type="VARCHAR(128)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
