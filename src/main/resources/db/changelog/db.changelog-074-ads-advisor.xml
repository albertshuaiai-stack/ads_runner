<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- 投前方案: 佣金/条款/关键词/广告文案 / pre-launch plan: commission, terms, keywords, ad copy -->
    <changeSet id="ads-advisor-001-campaign-plan" author="copilot">
        <createTable tableName="ADS_CAMPAIGN_PLAN">
            <column name="ID" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="ADS_OWNER" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="CAMPAIGN_NAME" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="BRAND_NAME" type="VARCHAR(128)"/>
            <column name="COUNTRY" type="VARCHAR(8)"/>
            <column name="PLATFORM_NAME" type="VARCHAR(64)"/>
            <column name="LANDING_URL" type="VARCHAR(1024)"/>
            <column name="COMMISSION_TYPE" type="VARCHAR(16)"/>
            <column name="COMMISSION_VALUE" type="DECIMAL(18,4)"/>
            <column name="AVG_ORDER_VALUE" type="DECIMAL(18,4)"/>
            <column name="EXPECTED_APPROVAL_RATE" type="DECIMAL(6,4)"/>
            <column name="COOKIE_DAYS" type="INT"/>
            <column name="ALLOW_PPC" type="VARCHAR(8)"/>
            <column name="ALLOW_BRAND_BID" type="VARCHAR(8)"/>
            <column name="ALLOW_COUPON_TERMS" type="VARCHAR(8)"/>
            <column name="EXPECTED_CPC" type="DECIMAL(18,4)"/>
            <column name="DAILY_BUDGET" type="DECIMAL(18,4)"/>
            <column name="KEYWORDS" type="TEXT"/>
            <column name="NEGATIVE_KEYWORDS" type="TEXT"/>
            <column name="HEADLINES" type="TEXT"/>
            <column name="DESCRIPTIONS" type="TEXT"/>
            <column name="NOTES" type="VARCHAR(1000)"/>
            <column name="CREATE_DATE" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="UPDATE_DATE" type="TIMESTAMP"/>
        </createTable>
        <addUniqueConstraint tableName="ADS_CAMPAIGN_PLAN" columnNames="ADS_OWNER, CAMPAIGN_NAME"
                             constraintName="UK_ADS_CAMPAIGN_PLAN_OWNER_CAMPAIGN"/>
    </changeSet>

    <!-- 按天 x 网络类型的 Google Ads 数据, 脚本每次覆盖最近几天 / per day and network, overwritten by each script run -->
    <changeSet id="ads-advisor-002-daily-stat" author="copilot">
        <createTable tableName="ADS_DAILY_STAT">
            <column name="ID" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="ADS_OWNER" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="CAMPAIGN_NAME" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="STAT_DATE" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="NETWORK" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="IMPRESSIONS" type="BIGINT"/>
            <column name="CLICKS" type="BIGINT"/>
            <column name="COST" type="DECIMAL(18,4)"/>
            <column name="CURRENCY" type="VARCHAR(8)"/>
            <column name="CREATE_DATE" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="UPDATE_DATE" type="TIMESTAMP"/>
        </createTable>
        <addUniqueConstraint tableName="ADS_DAILY_STAT" columnNames="ADS_OWNER, CAMPAIGN_NAME, STAT_DATE, NETWORK"
                             constraintName="UK_ADS_DAILY_STAT_KEY"/>
        <createIndex indexName="IDX_ADS_DAILY_STAT_OWNER_DATE" tableName="ADS_DAILY_STAT">
            <column name="ADS_OWNER"/>
            <column name="STAT_DATE"/>
        </createIndex>
    </changeSet>

    <!-- 广告系列设置与展示份额快照 / campaign settings and impression share snapshot -->
    <changeSet id="ads-advisor-003-campaign-snapshot" author="copilot">
        <createTable tableName="ADS_CAMPAIGN_SNAPSHOT">
            <column name="ID" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="ADS_OWNER" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="CAMPAIGN_NAME" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="CURRENCY" type="VARCHAR(8)"/>
            <column name="GOOGLE_SEARCH" type="BOOLEAN"/>
            <column name="SEARCH_PARTNERS" type="BOOLEAN"/>
            <column name="DISPLAY_NETWORK" type="BOOLEAN"/>
            <column name="GEO_TARGET_TYPE" type="VARCHAR(32)"/>
            <column name="BIDDING_STRATEGY" type="VARCHAR(48)"/>
            <column name="DAILY_BUDGET" type="DECIMAL(18,4)"/>
            <column name="CPC_CEILING" type="DECIMAL(18,4)"/>
            <column name="SEARCH_IMPRESSION_SHARE" type="DECIMAL(8,4)"/>
            <column name="BUDGET_LOST_SHARE" type="DECIMAL(8,4)"/>
            <column name="RANK_LOST_SHARE" type="DECIMAL(8,4)"/>
            <column name="REPORT_DATE" type="DATE"/>
            <column name="CREATE_DATE" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="UPDATE_DATE" type="TIMESTAMP"/>
        </createTable>
        <addUniqueConstraint tableName="ADS_CAMPAIGN_SNAPSHOT" columnNames="ADS_OWNER, CAMPAIGN_NAME"
                             constraintName="UK_ADS_CAMPAIGN_SNAPSHOT_KEY"/>
    </changeSet>

    <!-- 近 7 天搜索词快照, 用于找否定关键词 / last-7-day search terms, used to find negative keywords -->
    <changeSet id="ads-advisor-004-search-term-stat" author="copilot">
        <createTable tableName="ADS_SEARCH_TERM_STAT">
            <column name="ID" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="ADS_OWNER" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="CAMPAIGN_NAME" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="SNAPSHOT_DATE" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="SEARCH_TERM" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="IMPRESSIONS" type="BIGINT"/>
            <column name="CLICKS" type="BIGINT"/>
            <column name="COST" type="DECIMAL(18,4)"/>
            <column name="CREATE_DATE" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="IDX_ADS_SEARCH_TERM_OWNER_DATE" tableName="ADS_SEARCH_TERM_STAT">
            <column name="ADS_OWNER"/>
            <column name="SNAPSHOT_DATE"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
